// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  firstName     String?
  lastName      String?
  degree        String? // วุฒิการศึกษา (เช่น ป.เอก)
  position      String? // ตำแหน่ง (เช่น อ.ดร.)
  department    String? // สังกัดวิชา
  faculty       String? // คณะ
  major         String? // สาขา
  type          String? // ประเภทอาจารย์ (เช่น อาจารย์ประจำ, อาจารย์พิเศษ)
  teachingLevel String? // ระดับการสอน (เช่น ป.ตรี, ป.โท, ป.เอก)
  email         String   @unique
  password      String
  role          UserRole @default(USER)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  emailVerificationTokens EmailVerificationToken[]
  passwordResetOtps       PasswordResetOtp[]
  forms                   Form[]
  semesterTracking        SemesterTracking[]
}

model SubjectSectionRate {
  id                String  @id @default(cuid())
  subjectId         String
  subjectName       String
  semester          String
  program           Program @default(REGULAR_PROGRAM)
  // Section แบ่งเป็น LECTURE กับ LAB
  section           String
  //หมู่เรียน
  sectionId         String
  kind              Section
  // ข้อมูล rate และชั่วโมง
  ratePerHour       Float // อัตราค่าตอบแทนต่อชั่วโมง
  MaxTotalHours     Float // ชั่วโมงสอนต่อภาคสูงสุดที่เท่าไหร่ (30, 45)
  teacherTotalHours Float? // ชั่วโมงที่อาจารย์ request ต้องการสอน (ถ้ามี)

  @@unique([subjectId, sectionId, semester, program, section])
}

model SemesterTracking {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester    String
  program     Program @default(REGULAR_PROGRAM)
  // Section แบ่งเป็น LECTURE กับ LAB
  section     String
  year        Int
  subjectId   String
  subjectName String
  sectionId   String
  kind        Section

  totalHoursRequired Float // ชั่วโมงที่ต้องสอนทั้งภาค (copy จาก subjectSectionRate.defaultTotalHours)
  hoursUsed          Float @default(0) // ชั่วโมงที่สอนไปแล้ว
  hoursRemaining     Float // totalHoursRequired - hoursUsed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([semester, year, subjectId, sectionId, program, section])
  @@index([semester, year, program, section])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetOtp {
  id        String    @id @default(cuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Form {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  isCompensated Boolean    @default(false) // false = สอนปกติ, true = มีการชดเชย
  program       Program    @default(REGULAR_PROGRAM)
  section       Section    @default(LECTURE)
  month         String
  semester      String
  year          Int
  subjectId     String
  subjectName   String
  status        FormStatus @default(PENDING)
  adminComment  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formScheduleDetails FormSections[]

  @@index([userId, semester, year])
}

model FormSections {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  sectionId String
  kind      Section? @default(LECTURE)

  totalHours Float?

  schedules    Schedule[]
  compensation Compensation[]
}

model Schedule {
  id            String         @id @default(cuid())
  formSectionId String
  formSection   FormSections   @relation(fields: [formSectionId], references: [id], onDelete: Cascade)
  date          DateTime
  time          String
  totalHour     Float
  topic         String
  room          String
  note          String?
  Compensation  Compensation[]
}

model Compensation {
  id                 String       @id @default(cuid())
  formSectionId      String
  formSection        FormSections @relation(fields: [formSectionId], references: [id], onDelete: Cascade)
  originalScheduleId String? // คาบที่ชดเชย
  originalSchedule   Schedule?    @relation(fields: [originalScheduleId], references: [id], onDelete: Cascade)
  originalDate       DateTime
  originalTime       String
  newDate            DateTime
  newTime            String
  reason             String
}

enum UserRole {
  USER
  MAJOR_ADMIN
  FACULTY_ADMIN
  SUPER_ADMIN
}

enum FormStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Program {
  REGULAR_PROGRAM // ภาคปกติ
  SPECIAL_PROGRAM // ภาคพิเศษ
}

enum Section {
  LECTURE // บรรยาย
  LAB // ปฏิบัติการ
}
